# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./social_studio.db

# Real Publisher Adapter Config
# Choose either Discord Webhook or Telegram Bot
ACTIVE_REAL_PUBLISHER=discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/placeholder_id/placeholder_token
TELEGRAM_BOT_TOKEN=placeholder_bot_token
TELEGRAM_CHAT_ID=placeholder_chat_id

# Optional AI Content Generator (leave empty to use built-in template engine)
GEMINI_API_KEY=
